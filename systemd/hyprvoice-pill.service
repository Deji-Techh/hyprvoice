[Unit]
Description=hyprvoice audio-notch pill (always-on-top overlay)
Documentation=https://github.com/Deji-Techh/hyprvoice
Wants=graphical-session.target
After=graphical-session.target
# Follow the session: logout stops it so a stale pill can never linger,
# and a fresh login brings it back via [Install].
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c hyprvoice-pill
Restart=always
RestartSec=3s
# A widget, not work: deprioritize like other pills.
CPUWeight=10
Nice=10
IOSchedulingClass=idle
MemoryMax=300M

NoNewPrivileges=yes
PrivateTmp=yes
# NOTE: keep this at `true`, never `strict`. The pill spawns
# `hyprvoice toggle`, which must write pid/wav/state files to
# $XDG_RUNTIME_DIR — `strict` mounts the whole hierarchy (including /run)
# read-only and every click fails with EROFS.
ProtectSystem=true
# NOTE: ProtectHome also seals /run/user (yes, really — Home includes the
# runtime dir). The pill spawns `hyprvoice toggle`, which writes pid/wav/
# state files there and talks to PipeWire + Hyprland sockets, so the whole
# user runtime dir stays writable. /home itself is still read-only except
# the two whitelisted paths (config + Qt/cache writes, incl. the saved
# last-transcript file).
ProtectHome=read-only
ReadWritePaths=%t %h/.config/quickshell/hyprvoice-pill %h/.cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

TimeoutStopSec=10s

[Install]
WantedBy=graphical-session.target
